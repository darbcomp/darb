PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
# Use lax locally. For a cross-site production frontend/API pair, use none.
COOKIE_SAME_SITE=lax

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Example: https://media.darbfragrances.com
R2_PUBLIC_BASE_URL=

GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Darb
ADMIN_NOTIFICATION_EMAIL=

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Meta Conversions API (server-only)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_ENABLED=false
META_CAPI_TEST_EVENT_CODE=
META_CAPI_GRAPH_VERSION=v26.0